prune *
graft src
graft tests
graft cpp
graft bindings
# Header-only dependencies of the compiled backend, so that an sdist can build
# ruptures._core on its own (git submodules of the source checkout).
graft extern/armadillo/include
graft extern/carma/include

include LICENSE README.md pyproject.toml setup.py setup.cfg
exclude CHANGELOG.md CONTRIBUTING.md mkdocs.yml mkdocs_macros.py
global-exclude __pycache__ *.py[cod] .*
